# Renommer ce fichier en .env et remplir avec tes vraies valeurs
PORT=3000
FIREBASE_PROJECT_ID=ton-projet-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ton-projet.iam.gserviceaccount.com
# La clé privée : copier depuis le fichier JSON du service account Firebase
# Garder les \n littéraux, ils seront convertis dans config/firebase.js
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
